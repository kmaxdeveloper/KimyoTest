<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/colorSurface">

    <!-- Top Dashboard (Score, Best, Coins) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/style_game_board"
        android:alpha="0.95">

        <!-- Back button integrated into dashboard -->
        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:padding="8dp"
            android:src="@drawable/image_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="back" />

        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:background="#20FFFFFF"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>

        <!-- Score Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BALL"
                android:textColor="#80FFFFFF"
                android:textSize="8sp"
                android:fontFamily="@font/madimi"/>
            <TextView
                android:id="@+id/scoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/madimi"/>
        </LinearLayout>

        <!-- Best Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REKORD"
                android:textColor="#80FFFFFF"
                android:textSize="8sp"
                android:fontFamily="@font/madimi"/>
            <TextView
                android:id="@+id/bestScoreText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFD700"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/madimi"/>
        </LinearLayout>

        <!-- Coins Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TANGA"
                android:textColor="#80FFFFFF"
                android:textSize="8sp"
                android:fontFamily="@font/madimi"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/ic_coin"
                    android:layout_marginEnd="4dp"/>
                <TextView
                    android:id="@+id/coinText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/madimi"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Swipe hint (Back at top, improved) -->
    <TextView
        android:id="@+id/swipeHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/madimi"
        android:gravity="center"
        android:text="@string/swipeToPlay"
        android:textColor="#B0FFFFFF"
        android:textSize="14sp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp" />

    <!-- O'yin maydoni: 4x4 GridLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/gameBoard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/style_game_board"
            android:orientation="vertical"
            android:padding="6dp">

            <!-- Qatorlar dinamik ravishda kodda yaratiladi -->
            <LinearLayout
                android:id="@+id/row0"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/cell_0_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_0_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_0_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_0_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/row1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/cell_1_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_1_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_1_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_1_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/row2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/cell_2_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_2_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_2_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_2_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/row3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">
                <FrameLayout android:id="@+id/cell_3_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_3_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_3_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
                <FrameLayout android:id="@+id/cell_3_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="4dp" android:background="@drawable/style_empty_cell" android:layout_margin="2dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Animatsiya uchun ustki qatlam -->
        <FrameLayout
            android:id="@+id/animationOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="@id/gameBoard"
            app:layout_constraintBottom_toBottomOf="@id/gameBoard"
            app:layout_constraintStart_toStartOf="@id/gameBoard"
            app:layout_constraintEnd_toEndOf="@id/gameBoard"
            android:clipChildren="false"
            android:clipToPadding="false" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Helpers (Yordamchilar) Bar -->
    <LinearLayout
        android:id="@+id/powerUpsBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        android:padding="12dp"
        android:background="@drawable/style_game_board"
        android:alpha="0.95">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yordamchilar"
            android:textColor="#80FFFFFF"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_gravity="center"
            android:fontFamily="@font/madimi"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <!-- Earn Coins -->
            <LinearLayout
                android:id="@+id/btnEarnCoins"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:background="@drawable/style_score_box"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/image_watch_ads" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+25"
                    android:textSize="11sp"
                    android:textColor="#00FF00"
                    android:textStyle="bold"
                    android:fontFamily="@font/madimi"/>
            </LinearLayout>

            <!-- Hammer Power-up -->
            <LinearLayout
                android:id="@+id/btnHammer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:background="@drawable/style_score_box"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_hammer" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="50"
                    android:textSize="11sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:fontFamily="@font/madimi"/>
            </LinearLayout>

            <!-- Cleanup Power-up -->
            <LinearLayout
                android:id="@+id/btnCleanup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_margin="4dp"
                android:background="@drawable/style_score_box"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">
                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_sparkles" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="100"
                    android:textSize="11sp"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:fontFamily="@font/madimi"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Game Over / Win overlay (initially GONE) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/gameOverCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#CC1D2631"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <TextView
                android:id="@+id/gameOverTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/madimi"
                android:text="@string/gameOver"
                android:textColor="@android:color/white"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gameOverScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/karla_light"
                android:textColor="#B0FFFFFF"
                android:textSize="16sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:weightSum="2">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reviveBtn"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:fontFamily="@font/madimi"
                    android:text="@string/reviveGame"
                    android:textSize="12sp"
                    android:padding="0dp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/image_watch_ads"
                    app:iconGravity="textStart"
                    app:iconSize="18dp"
                    app:iconPadding="4dp"
                    app:iconTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/newGameBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/madimi"
                    android:text="@string/newGame"
                    android:textSize="12sp"
                    app:cornerRadius="12dp" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
