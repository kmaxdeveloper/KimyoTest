<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — Kimyo Laboratoriyasi (Light) -->
    <style name="Base.Theme.KimyoTest" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Kimyo Light: Toza laboratoriya ohangi -->
        <item name="android:windowBackground">@color/chem_background_light</item>
        <item name="android:textColorPrimary">@color/chem_on_surface_light</item>
        <item name="colorPrimary">@color/chem_primary_light</item>
        <item name="colorOnPrimary">@color/chem_surface_light</item>
        <item name="colorSurface">@color/chem_surface_light</item>
        <item name="colorOnSurface">@color/chem_on_surface_light</item>
        <item name="colorOutline">@color/chem_outline_light</item>
        <item name="colorPrimaryContainer">@color/chem_toolbar_light</item>
        <item name="colorSurfaceVariant">@color/chem_surface_variant_light</item>
    </style>

    <style name="Theme.KimyoTest" parent="Base.Theme.KimyoTest"/>

    <style name="ShapeAppearanceOverlay.App.CornerSize50Percent" parent="">
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.CornerSize20Percent" parent="">
        <item name="cornerSize">20%</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.CornerSize10Percent" parent="">
        <item name="cornerSize">10%</item>
    </style>
    <style name="VariantStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">true</item>
        <item name="android:background">@drawable/style_test_default_answer</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="TestCountStyle">
        <item name="android:layout_width">11.5dp</item>
        <item name="android:layout_height">11.5dp</item>
        <item name="android:background">@drawable/style_test_count</item>
        <item name="android:layout_marginEnd">0.5dp</item>
        <item name="android:layout_marginStart">0.5dp</item>
    </style>
    <style name="PrivacyPolicyTextBlockStyle">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="PrivacyPolicyTextStyle">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="StyleTestCorrectAnswer">
        <item name="android:background">@drawable/style_test_correct_answer</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="StyleTestWrongAnswer">
        <item name="android:background">@drawable/style_test_wrong_answer</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="StyleTestDefaultAnswer">
        <item name="android:background">@drawable/style_test_default_answer</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

</resources>
